# =============================================================================
# Variables de entorno · copiá este archivo como .env.local y completalo.
# En Vercel, cargá las mismas variables en Project → Settings → Environment Variables.
# =============================================================================

# URL pública del sitio (sin barra final). En local: http://localhost:3000
# En Vercel: https://tu-proyecto.vercel.app
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Supabase (Project Settings → API) ---------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# Clave pública (anon / publishable). Se puede exponer al navegador.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# ⚠️ Clave SECRETA (service_role / secret). Solo servidor. Nunca la compartas.
SUPABASE_SERVICE_ROLE_KEY=

# --- Manager -------------------------------------------------------------------
# Correo del manager: recibe las notificaciones de reservas.
MANAGER_EMAIL=ivandmg150@gmail.com

# --- Correo -------------------------------------------------------------------
# Proveedor: "gmail" (por defecto) o "resend" (cuando tengas dominio propio)
EMAIL_PROVIDER=gmail
# Remitente que verán los clientes
EMAIL_FROM_NAME=Clínica Estética Ivan
EMAIL_FROM_ADDRESS=ivandmg150@gmail.com

# Gmail SMTP: contraseña de aplicación de 16 letras (sin espacios). Ver README.
GMAIL_USER=ivandmg150@gmail.com
GMAIL_APP_PASSWORD=

# Resend (opcional, futuro)
RESEND_API_KEY=

# --- Seguridad ----------------------------------------------------------------
# Secreto para el Cron de recordatorios (Vercel lo envía automáticamente).
# Generalo con: openssl rand -hex 32
CRON_SECRET=
# Secreto para "anonimizar" IPs en el rate limit. Generalo igual que el anterior.
IP_HASH_SECRET=

# --- Tests (solo local, opcional) ---------------------------------------------
# Postgres local para `npm run test:db` (NUNCA la base de producción)
# TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5432/postgres
